# Copy to .env and fill in. Secrets are read from the environment only.

# Slack incoming webhook used for alarms and intrusion route reports.
SLACK_WEBHOOK_URL=

# Token required to view the operator dashboard (X-Auth-Token header or ?token=).
DASHBOARD_TOKEN=change-me-operator-token

# Set to "true" only when the honeypot sits behind a trusted reverse proxy that
# sets X-Forwarded-For. Leave empty/false when exposed directly (default).
TRUST_FORWARDED_FOR=false

# Optional: override log level (debug|info|warn|error).
LOG_LEVEL=info
